# Frontend build-time configuration (Vite). Copy to .env.local for local overrides.
# Never place secrets or API keys here - every VITE_* value is embedded in the public bundle.

# static (default): reads public/data/*.json - the GitHub Pages demo.
# api: reads from the FastAPI backend (see backend/README.md).
VITE_DATA_MODE=static
VITE_API_BASE_URL=http://localhost:8000/api/v1
