# Copy to backend/.env for local overrides. Never commit a real .env file.

# SQLAlchemy URL. SQLite is the zero-configuration default; replace with e.g.
# postgresql+psycopg://user:password@host:5432/maritime_ai (install the driver separately).
DATABASE_URL=sqlite:///./maritime_ai.db

# Directory containing the Phase 1 operational datasets (defaults to ../public/data).
# DATA_DIR=../public/data

# Comma-separated list of browser origins permitted by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# AI provider: "deterministic" (default, no keys, always available) or "ollama" (optional local LLM).
AI_PROVIDER=deterministic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=20
